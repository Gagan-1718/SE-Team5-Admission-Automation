# Keep code and config line endings identical on Windows, macOS and Linux
*.py   text eol=lf
*.txt  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.ini  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Binary files: never convert line endings (a converted PDF is corrupted and the upload check rejects it)
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.mp4  binary
docs/demo/sample_files/** -text
